@startuml

' =============================================
' System Context Diagram (C4 style)
' =============================================

Person(user, "Writer", "A story author using the graph editor")

System_Boundary(storybuilder, "Story Builder") {
  Container(web, "React Flow UI", "React 19, Vite 8, @xyflow/react", "Visual DAG editor for plot structure")
  Container(api, "Go API Server", "Go 1.24, chi router", "REST API for CRUD + LLM generation + agent orchestration")
  Container(db, "MongoDB", "MongoDB 7", "Primary SSOT — stories, scenes, characters, generations, state, memories")
  Container(redis, "Redis", "Redis 7", "Cache + rate limiter + dist lock + job queue")
  Container(workers, "Pipeline Workers", "In-process goroutines", "6 async workers: generate, extract, memory, summary, timeline, validate")
  Container(agents, "Runtime Agents", "In-process actors", "10 orchestrated agents: Director, Narrator, Character×N, Editor, CanonGuard, Critic, World, Arc, Memory")
  Container(llm, "LLM Service", "Go LLM client", "Anthropic Sonnet/Haiku + OpenCode (local-7b) + headroom compression")
}

System_Ext(anthropic, "Anthropic API", "External LLM API (Sonnet, Haiku)")
System_Ext(opencode, "OpenCode (local)", "Local LLM (7B models)")

Rel(user, web, "Edits story graph")
Rel(web, api, "/api/v1/*", "HTTP JSON")
Rel(api, db, "mongo-go-driver", "Document queries")
Rel(api, redis, "go-redis", "Caching + rate limiting")
Rel(api, agents, "AgentService.GenerateScene()")
Rel(agents, llm, "LLM calls per turn")
Rel(workers, db, "Mongo queries")
Rel(workers, llm, "LLM calls")
Rel(workers, redis, "Job polling + coordination")
Rel(llm, anthropic, "HTTPS", "Anthropic Messages API")
Rel(llm, opencode, "HTTP", "OpenCode chat API")

@enduml
