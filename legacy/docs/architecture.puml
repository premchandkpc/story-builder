@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false

actor User
package "Web App" {
  component React
  component "Story Graph"
}

package "API (Go/chi)" {
  component Router
  component Handlers
  component Services
}

package "Domain & Engine" {
  component "Domain Models"
  component "Graph Engine"
  component "LLM Service"
  component "Prompt Compiler"
  component "Event Bus"
  component "Validation"
  component "Projection"
}

package "Runtime Agents" {
  component "Agent Orchestrator"
  component "Director"
  component "Narrator"
  component "Character Agents"
  component "Editor"
  component "CanonGuard"
  component "World/Arc/Memory"
  component "Workers"
}

package "Data" {
  database MongoDB
  database Redis
}

User --> React
React --> Router
Router --> Handlers
Handlers --> Services
Services --> "Domain Models"
Services --> "Graph Engine"
Services --> "LLM Service"
Services --> "Prompt Compiler"
Services --> "Agent Orchestrator"
Services --> Validation
"Agent Orchestrator" --> Director
"Agent Orchestrator" --> Narrator
"Agent Orchestrator" --> "Character Agents"
"Agent Orchestrator" --> Editor
"Agent Orchestrator" --> CanonGuard
"Agent Orchestrator" --> "World/Arc/Memory"
Workers --> "LLM Service"
Workers --> "Prompt Compiler"
"LLM Service" --> MongoDB
Services --> MongoDB
Services --> Redis
"Domain Models" --> MongoDB
StoryGraph --> Router
@enduml
