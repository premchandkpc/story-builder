@startuml

' =============================================
' System Context Diagram (C4 style)
' =============================================

Person(user, "Writer", "A story author using the graph editor")

System_Boundary(storybuilder, "Story Builder") {
  Container(web, "React Flow UI", "React 19, Vite 8, @xyflow/react", "Visual DAG editor for plot structure")
  Container(api, "Go API Server", "Go, chi router", "REST API for CRUD + LLM generation")
  Container(db, "PostgreSQL + pgvector", "Postgres 16", "Persistent storage with vector search")
  Container(redis, "Redis", "Cache + rate limiter + dist lock", "Optional prompt/context caching")
  Container(river, "River Job Queue", "River (Go)", "Async LLM job processing")
  Container(llm, "LLM Service", "Anthropic Sonnet/Haiku + Ollama", "AI prose generation + validation")
}

System_Ext(anthropic, "Anthropic API", "External LLM API (Sonnet, Haiku)")
System_Ext(ollama, "Ollama (local)", "Local LLM (7B models)")

Rel(user, web, "Edits story graph")
Rel(web, api, "/api/v1/*", "HTTP JSON")
Rel(api, db, "pgxpool", "SQL queries")
Rel(api, redis, "go-redis", "Caching + rate limiting")
Rel(api, river, "Job insertion")
Rel(river, db, "SQL queries")
Rel(river, llm, "Go method calls")
Rel(river, redis, "go-redis", "Job coordination")
Rel(llm, anthropic, "HTTPS", "Anthropic Messages API")
Rel(llm, ollama, "HTTP", "Ollama chat API")

@enduml
