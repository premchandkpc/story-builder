@startuml

' =============================================
' Package Dependency Diagram
' =============================================

package "cmd/server" as CMD {
  [main.go]
  [init.go]
}

package "internal/api" as API {
  [router.go]
  [handlers*.go]
  [middleware.go]
}

package "internal/service" as SVC {
  [story.go]
  [scene.go]
  [generation.go]
  [character.go]
  [memory.go]
  [agents.go]
}

package "internal/domain" as DOM {
  [story/]
  [scene/]
  [character/]
  [memory/]
  [timeline/]
}

package "internal/repository" as REPO {
  [interfaces.go]
}

package "internal/repository/mongo" as MONGO {
  [client.go]
  [stories.go]
  [scenes.go]
  [edges.go]
  [characters.go]
  [generations.go]
  [memories.go]
  [timeline.go]
  [+16 more]
}

package "internal/llm" as LLM {
  [client.go]
  [router.go]
  [compress.go]
  [cache.go]
}

package "internal/prompt" as PROMPT {
  [compiler.go]
  [templates.go]
}

package "internal/agents" as AGENTS {
  [orchestrator.go]
  [director.go]
  [narrator.go]
  [character_manager.go]
  [character_agent.go]
  [editor.go]
  [canon_guard.go]
  [critic.go]
  [world.go]
  [arc.go]
  [memory_agent.go]
}

package "internal/worker" as WORKER {
  [generate.go]
  [extract.go]
  [memory.go]
  [summary.go]
  [timeline.go]
  [validate.go]
}

package "internal/graph" as GRAPH {
  [traversal.go]
  [validate.go]
}

package "internal/validation" as VALID {
  [rules.go]
  [result.go]
}

package "internal/events" as EVT {
  [bus.go]
  [types.go]
}

package "internal/cache" as CACHE {
  [redis_client.go]
  [rate_limiter.go]
  [dist_lock.go]
  [context_cache.go]
}

package "internal/projection" as PROJ {
  [character_view.go]
  [timeline.go]
}

package "internal/config" as CFG {
  [config.go]
}

CMD --> API : HTTP handlers
CMD --> MONGO : mongo.Client (via mgorepo)
CMD --> LLM : clients
CMD --> WORKER : lifecycle
CMD --> CACHE : Redis client
CMD --> CFG : config
CMD --> EVT : event bus

API --> SVC : service calls
API --> CACHE : rate limiter

SVC --> DOM : domain types
SVC --> REPO : repository interfaces
SVC --> LLM : generation
SVC --> PROMPT : prompt compiler
SVC --> AGENTS : agent service
SVC --> VALID : validation
SVC --> EVT : publish events

WORKER --> REPO : repository interfaces
WORKER --> LLM : service calls
WORKER --> PROMPT : prompt builders
WORKER --> AGENTS : character agent access

AGENTS --> LLM : LLM calls
AGENTS --> DOM : domain types
AGENTS --> EVT : publish/consume events

PROMPT --> DOM : domain types

GRAPH --> DOM : domain types

CACHE --> LLM : cached wrapper

PROJ --> DOM : domain types
PROJ --> REPO : persistence

@enduml
