@startuml

' =============================================
' Package Dependency Diagram
' =============================================

package "cmd/server" as CMD {
  [main.go]
}

package "internal/api" as API {
  [router.go]
  [handlers_stories.go]
  [handlers_characters.go]
  [handlers_generation.go]
  [handlers_timeline.go]
  [handlers_blueprints.go]
  [request_validation.go]
  [middleware.go]
  [mwlogger.go]
}

package "internal/graph" as GRAPH {
  [models.go]
  [traversal.go]
  [memory.go]
}

package "internal/canon" as CANON {
  [models.go]
  [memory.go]
}

package "internal/ledger" as LEDGER {
  [models.go]
  [memory.go]
}

package "internal/compiler" as COMPILER {
  [compiler.go]
  [prompts.go]
  [summary.go]
  [memory.go]
}

package "internal/llm" as LLM {
  [types.go]
  [services.go]
  [client.go]
  [router.go]
}

package "internal/scene" as SCENE {
  [types.go]
  [agent.go]
  [turn.go]
}

package "internal/river" as RIVER {
  [jobs.go]
}

package "internal/db" as DB {
  [db.go]
  [models.go]
  [queries.sql.go]
  [extras.go]
  [actor_traits.go]
}

package "internal/migrate" as MIGRATE {
  [runner.go]
}

package "internal/cache" as CACHE {
  [cache.go]
  [cached_llm.go]
  [context_cache.go]
  [prompt_cache.go]
  [rate_limiter.go]
  [dist_lock.go]
  [redis_client.go]
  [workflow.go]
}

package "internal/narrative" as NARRATIVE {
  [models.go]
  [types.go]
}

package "internal/timeline" as TL {
  [models.go]
}

package "internal/agent" as AGENT {
  [models.go]
  [service.go]
}

package "internal/memory" as MEM {
  [models.go]
  [store.go]
}

package "internal/planner" as PLAN {
  [models.go]
  [store.go]
}

package "internal/workflow" as WF {
  [models.go]
  [store.go]
  [saga.go]
}

CMD --> API : HTTP handlers
CMD --> DB : pgxpool
CMD --> LLM : clients
CMD --> RIVER : workers
CMD --> MIGRATE : runner
CMD --> GRAPH : memory store (fallback)
CMD --> CANON : memory store (fallback)
CMD --> LEDGER : memory store (fallback)
CMD --> COMPILER : memory store (fallback)
CMD --> CACHE : Redis client

API --> DB : queries
API --> GRAPH : domain types
API --> CANON : domain types
API --> COMPILER : generation types
API --> SCENE : scene service
API --> CACHE : rate limiter

RIVER --> DB : queries
RIVER --> LLM : service calls
RIVER --> CANON : card types
RIVER --> LEDGER : state types
RIVER --> COMPILER : prompt builders

COMPILER --> CANON : card types
COMPILER --> LEDGER : state types

GRAPH --> CANON : domain types (via API)

CACHE --> LLM : cached wrapper

AGENT --> LLM : agent prompts
MEM --> DB : persistence
PLAN --> DB : persistence
WF --> DB : persistence

@enduml
