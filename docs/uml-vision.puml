@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle

title Story Builder — Architecture

' ── Data Stores ──

package "Data Stores" {
  database "MongoDB" as MONGO {
    frame "Primary SSOT" as SSOT
    frame "stories"
    frame "scenes"
    frame "characters"
    frame "generations"
    frame "character_state"
    frame "memories"
    frame "timeline_events"
  }

  database "Redis" as REDIS {
    frame "Cache" as CACHE
    frame "prompt_cache"
    frame "context_cache"
    frame "rate_limiter"
    frame "dist_lock"
    frame "job_queue"
  }
}

' ── Domain Model ──

package "Domain Model" {
  frame "Story" as S
  frame "Scene" as SE
  frame "SceneEdge" as EDGE
  frame "Character" as C
  frame "CharacterState" as CS
  frame "CharacterMemory" as M
  frame "Generation" as G
  frame "TimelineEvent" as T
}

S --> SE : contains scenes
SE --> EDGE : linked by edges
SE --> C : involves characters
C --> CS : append-only state
C --> M : semantic memories
SE --> G : LLM outputs

' ── Services ──

package "Services" {
  frame "Prompt Compiler" as PC
  frame "Generation Service" as GS
  frame "Character Service" as CHS
  frame "Timeline Service" as TS
  frame "Memory Service" as MS
  frame "Validation Service" as VS
  frame "Agent Service" as AS
}

' ── Runtime Agents ──

package "Runtime Agents" {
  frame "Orchestrator" as ORC
  frame "Director" as DIR
  frame "Narrator" as NAR
  frame "Character Agents" as CAGS
  frame "Editor" as ED
  frame "CanonGuard" as CG
  frame "Critic" as CR
  frame "World/Arc/Memory" as WAM
}

' ── Workers ──

package "Workers (goroutines)" {
  frame "Generate" as WGEN
  frame "ExtractState" as WEXT
  frame "MemoryUpdate" as WMEM
  frame "Timeline" as WTL
  frame "Summary" as WSUM
  frame "Validate" as WVAL
}

' ── External ──

rectangle "LLM Providers" as LLM {
  frame "Anthropic"
  frame "OpenCode"
}

' ── Connections ──

PC --> MONGO : templates + lore
PC --> REDIS : prompt cache

GS --> MONGO : scene + state
GS --> LLM : completion request
GS --> VS : validate output

CHS --> MONGO : state persistence
CHS --> CAGS : per-character agents

TS --> MONGO : event store
TS --> REDIS : timeline cache

MS --> MONGO : semantic search
MS --> MONGO : memory write

VS --> MONGO : validation results

AS --> MONGO : agent runs + turns
AS --> ORC : orchestrate scene
AS --> REDIS : job queue

ORC --> DIR : direct scene flow
ORC --> NAR : narrate prose
ORC --> CAGS : character turns
ORC --> ED : polish output
ORC --> CG : verify consistency
ORC --> CR : score scene
ORC --> WAM : world/arc/memory

WGEN --> LLM : generate prose
WGEN --> LORE : context building
WEXT --> MONGO : extract state
WMEM --> MONGO : store memories
WSUM --> MONGO : update summaries
WVAL --> MONGO : validate canon

' ── In-Memory Events ──

frame "Event Bus" as EVT {
}

GS --> EVT : SceneGenerated
AS --> EVT : SceneTurnsComplete
CAGS --> EVT : CharacterActed

EVT --> TS : consume events
EVT --> MS : consume events
EVT --> WSUM : consume events

@enduml
