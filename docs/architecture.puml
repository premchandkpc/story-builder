@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false

actor User
package "Web App" {
  component React
  component "Story Graph"
}

package "API" {
  component Router
  component Handlers
  component Services
}

package "Domain" {
  component Canon
  component Graph
  component Ledger
  component Compiler
  component LLM
  component Narrative
  component Timeline
  component Agent
  component Memory
  component Planner
  component Workflow
}

package "Data" {
  database Postgres
  database pgvector
  database Redis
}

User --> React
React --> Router
Router --> Handlers
Handlers --> Services
Services --> Canon
Services --> Graph
Services --> Ledger
Services --> Compiler
Services --> LLM
Services --> Narrative
Services --> Memory
Services --> Planner
Compiler --> Canon
Compiler --> Ledger
LLM --> Postgres
Services --> Postgres
Postgres --> pgvector
Services --> Redis
StoryGraph --> Router
@enduml
