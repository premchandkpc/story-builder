@startuml

' =============================================
' DB Entity Relationship Diagram
' =============================================

entity stories {
  * id: uuid <<PK>>
  --
  * title: text
  * canon_pins: jsonb
  genre: text
  theme: text
  main_prompt: text
  general_prompt: text
  * created_at: timestamptz
}

entity chapters {
  * id: uuid <<PK>>
  --
  * story_id: uuid <<FK>>
  * title: text
  goal: text
  * order_index: int
  summary: text
  status: text
  * created_at: timestamptz
  * updated_at: timestamptz
}

entity scenes {
  * id: uuid <<PK>>
  --
  * chapter_id: uuid <<FK>>
  * story_id: uuid <<FK>>
  title: text
  * beat_intent: text
  character_refs: uuid[]
  location_ref: uuid
  pov: text
  tone: text
  target_words: int
  scene_structure: jsonb
  parent_scene_id: uuid
  timeline_position: text
  flow_type: text
  max_turns: int
  status: text
  * created_at: timestamptz
  * updated_at: timestamptz
}

entity scene_edges {
  * story_id: uuid <<FK>>
  * from_scene: uuid <<FK>>
  * to_scene: uuid <<FK>>
  --
  * edge_type: text
  condition: text
}

entity generations {
  * id: uuid <<PK>>
  --
  * scene_id: uuid <<FK>>
  * context_hash: text
  * prompt_snapshot: text
  * output: text
  * model: text
  * accepted: bool
  validation_result: jsonb
  * created_at: timestamptz
}

entity characters {
  * id: uuid
  * version: int
  --
  * name: text
  persona: text
  backstory: text
  moral_alignment: text
  personality: jsonb
  flaws: jsonb
  goals: jsonb
  traits: jsonb
  voice_samples: text[]
  relationships: jsonb
  parent_id: uuid
  * created_at: timestamptz
}

entity locations {
  * id: uuid
  * version: int
  --
  * name: text
  description: text
  props: jsonb
  * created_at: timestamptz
}

entity lore {
  * id: uuid <<PK>>
  --
  tags: text[]
  * content: text
  embedding: vector(768)
  * created_at: timestamptz
}

entity character_state {
  * story_id: uuid <<FK>>
  * character_id: uuid
  * as_of_scene: uuid <<FK>>
  --
  * state: jsonb
  * updated_at: timestamptz
}

entity actors {
  * id: uuid <<PK>>
  --
  * name: text
  gender: text
  ethnicity: text
  race: text
  skin_tone: text
  eye_color: text
  hair_color: text
  hair_style: text
  build: text
  height_cm: int
  weight_kg: int
  age: int
  nationality: text
  traits: jsonb
  * created_at: timestamptz
}

entity actor_traits {
  * id: uuid <<PK>>
  --
  * actor_id: uuid <<FK>>
  * trait_key: text
  * trait_value: text
  * created_at: timestamptz
}

entity character_traits {
  * id: uuid <<PK>>
  --
  * name: text
  category: text
  description: text
  * created_at: timestamptz
}

entity character_trait_assignments {
  * character_id: uuid
  * trait_id: uuid <<FK>>
  --
  intensity: int
  note: text
}

entity casting {
  * id: uuid <<PK>>
  --
  * story_id: uuid <<FK>>
  * actor_id: uuid <<FK>>
  * character_id: uuid
  role_type: text
  * created_at: timestamptz
}

entity scene_turns {
  * id: uuid <<PK>>
  --
  * scene_id: uuid <<FK>>
  * turn_number: int
  actor_ids: uuid[]
  prompt: text
  output: text
  model: text
  status: text
  * created_at: timestamptz
}

entity story_summaries {
  * id: uuid <<PK>>
  --
  * story_id: uuid <<FK>>
  scene_id: uuid <<FK>>
  * level: text
  * content: text
  word_count: int
  * created_at: timestamptz
}

' --- Relationships ---

stories ||--o{ chapters : "story_id"
stories ||--o{ scenes : "story_id"
stories ||--o{ scene_edges : "story_id"
stories ||--o{ character_state : "story_id"
stories ||--o{ casting : "story_id"
stories ||--o{ story_summaries : "story_id"

chapters ||--o{ scenes : "chapter_id"

scenes ||--o{ scene_edges : "from_scene"
scenes ||--o{ scene_edges : "to_scene"
scenes ||--o{ generations : "scene_id"
scenes ||--o{ scene_turns : "scene_id"
scenes ||--o{ character_state : "as_of_scene"
scenes ||--o{ story_summaries : "scene_id"
scenes ?--? scenes : "parent_scene_id"

characters ||--o{ character_state : "character_id"
characters ||--o{ casting : "character_id"
characters ||--o{ character_trait_assignments : "character_id"

actors ||--o{ casting : "actor_id"
actors ||--o{ actor_traits : "actor_id"
character_traits ||--o{ character_trait_assignments : "trait_id"

@enduml
